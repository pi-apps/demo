# Generate a random string, or roll your face on the keyboard to fill this value:
SESSION_SECRET=

# Get this on the Pi Developer Portal (https://develop.pinet.com in the Pi Browser)
PI_API_KEY=

# Platform API 
PLATFORM_API_URL=https://api.minepi.com

# MongoDB database connection details:
MONGO_HOST=localhost:27017
MONGODB_DATABASE_NAME=demoapp-development
MONGODB_USERNAME=demoapp
MONGODB_PASSWORD=dev_password

# Frontend app URL
FRONTEND_URL=http://localhost:3314

# Subscription processing (optional, see doc/subscription-processing.md).
# Secret seed (starts with S) of the wallet that owns your subscription service. Never commit or share it:
PI_MERCHANT_SECRET=
# Your service's id on the Subscription contract:
PI_SUBSCRIPTION_SERVICE_ID=
# Optional: subscriptions per transaction (default 20):
SUBSCRIPTION_PROCESS_BATCH_SIZE=
# Optional: "submit" (default) sends transactions, "simulate" only previews them:
SUBSCRIPTION_PROCESS_MODE=
