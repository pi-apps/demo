# ================================================
# GHN.PI - Environment Variables Example
# ================================================
# Copy file này thành .env rồi chỉnh sửa các giá trị phù hợp
# WARNING: Không được để comment (#) ở cuối dòng giá trị!
# Ví dụ sai: FRONTEND_URL=... # comment
# ================================================

# ================== PI NETWORK ==================
# Set to true when testing in Pi Sandbox
SANDBOX_SDK=true

# Lấy 2 giá trị này từ Pi Developer Portal (pi://develop.pinet.com)
PI_APP_ID=your_pi_app_id_here
PI_API_KEY=your_pi_api_key_here
DOMAIN_VALIDATION_KEY=your_domain_validation_key_here

# ================== APPLICATION URLs ==================
# URL của Frontend (thường là Vercel, Netlify...)
FRONTEND_URL=http://localhost:5173
FRONTEND_DOMAIN_NAME=localhost

# URL của Backend
BACKEND_URL=http://localhost:5000
BACKEND_DOMAIN_NAME=localhost

# ================== SERVER CONFIG ==================
# Port của Backend
PORT=5000

# Môi trường (development hoặc production)
ENVIRONMENT=development

# Secret key dùng cho session và JWT (phải thay bằng chuỗi mạnh)
SESSION_SECRET=change_this_to_a_very_long_random_string_at_least_32_characters
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_32_characters

# ================== DATABASE ==================
# MongoDB
MONGODB_DATABASE_NAME=ghn_pi
MONGODB_USERNAME=ghn_pi_user
MONGODB_PASSWORD=your_mongodb_password

# Connection string (dùng cái này cho production hoặc local MongoDB)
# MONGODB_URI=mongodb://mongo:27017/ghn_pi
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ghn_pi?retryWrites=true&w=majority

# ================== DOCKER ==================
# Tên project dùng cho Docker
COMPOSE_PROJECT_NAME=ghn-pi

# Thư mục lưu dữ liệu Docker (volume)
DATA_DIRECTORY=./docker-data

# ================== OTHER CONFIG ==================
# Platform API URL (không nên thay đổi)
PLATFORM_API_URL=https://api.minepi.com

# Frontend URL dùng cho CORS
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.com
